<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.chasse</groupId>
  <artifactId>chasse-studio-desktop</artifactId>
  <version>1.0.2</version>
  <packaging>jar</packaging>

  <name>Chasse Studio Desktop</name>
  <description>Chasse Studio desktop app with embedded LAN sync server for the phone remote</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Version of the jcefmaven bootstrap jar; the per-platform natives artifacts
         use the matching long-form version string below. -->
    <jcefmaven.version>152.0.6</jcefmaven.version>
    <jcef.natives.version>jcef-17e805a+cef-152.0.6+g708dc14+chromium-152.0.7977.83</jcef.natives.version>
  </properties>

  <dependencies>
    <!-- JCEF bootstrap: downloads natives to the install dir on first run
         (unless a per-platform natives profile below bundles them). -->
    <dependency>
      <groupId>me.friwi</groupId>
      <artifactId>jcefmaven</artifactId>
      <version>${jcefmaven.version}</version>
    </dependency>
    <!-- Embedded LAN sync server (HTTP + WebSocket on one port). -->
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
      <version>6.7.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.14.0</version>
    </dependency>
    <!-- slf4j binding for Javalin's logging (runtime only). -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.16</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <!-- Place the runnable jar next to the copied dependencies so that
               target/package is a complete classpath (java -cp "target/package/*")
               and a single jpackage input dir. -->
          <outputDirectory>${project.build.directory}/package</outputDirectory>
          <archive>
            <manifest>
              <mainClass>com.chasse.desktop.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/package</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Per-platform natives profiles: activate one to BUNDLE the JCEF natives
       for that OS into target/package (installer builds). The default build
       downloads the correct natives on first run instead. -->
  <profiles>
    <profile>
      <id>windows</id>
      <dependencies>
        <dependency>
          <groupId>me.friwi</groupId>
          <artifactId>jcef-natives-windows-amd64</artifactId>
          <version>${jcef.natives.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>macos-arm</id>
      <dependencies>
        <dependency>
          <groupId>me.friwi</groupId>
          <artifactId>jcef-natives-macosx-arm64</artifactId>
          <version>${jcef.natives.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>macos-intel</id>
      <dependencies>
        <dependency>
          <groupId>me.friwi</groupId>
          <artifactId>jcef-natives-macosx-amd64</artifactId>
          <version>${jcef.natives.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>linux</id>
      <dependencies>
        <dependency>
          <groupId>me.friwi</groupId>
          <artifactId>jcef-natives-linux-amd64</artifactId>
          <version>${jcef.natives.version}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
